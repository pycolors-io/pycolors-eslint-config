{
  "name": "@pycolors/eslint-config",
  "version": "1.0.0",
  "description": "Production-ready ESLint configs for Next.js, React, TypeScript and Turborepo projects.",
  "private": false,
  "type": "module",
  "files": [
    "base.js",
    "next.js",
    "react-internal.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/pycolors-io/pycolors-eslint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/pycolors-io/pycolors-eslint-config"
  },
  "bugs": {
    "url": "https://github.com/pycolors-io/pycolors-eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "nextjs",
    "react",
    "typescript",
    "turborepo",
    "lint",
    "code-quality",
    "developer-tools"
  ],
  "exports": {
    ".": "./base.js",
    "./base": "./base.js",
    "./next-js": "./next.js",
    "./react-internal": "./react-internal.js"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-turbo": "^2.8.0",
    "typescript-eslint": "^8.50.0",
    "globals": "^16.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "@next/eslint-plugin-next": "^16.0.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "types:check": "node -e \"console.log('skip')\""
  },
  "license": "MIT"
}
